<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-mcp: MCP (Model Context Protocol) 工具/服务注册中心.
        - api:     零依赖 DTO + exception(自己产出线格式视图)
        - core:    McpRegistry + 协议层(McpProtocolHandler) + Streamable HTTP/stdio 双向传输
        - starter: Spring Boot 自动装配
        - admin:   控制面 (servers/tools/health 视图)
        - server:  可部署进程(hub / text / codec 三种角色一个 fat jar), 只在 250 上跑, 不发中央仓库

        依赖面刻意收在 Spring Boot 2.7 + Jackson + SLF4J:
        - 不用官方 MCP Java SDK —— 它要求 Java 17 + Reactor, 本仓编译目标是 Java 8
        - 不依赖 z-agent-kernel —— 基建模块不能反向依赖应用层(0.1.x 那 4 个 kernel 依赖无人 import)
    -->

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径）：它继承第三方地板
         z-boot-dependencies:1.0.19、import 兄弟仓权威 z-boot-fleet:1.0.0，并下发 Java 8 的
         pluginManagement。relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.21</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mcp</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-mcp (MCP Tool &amp; Service Registry)</name>
    <description>MCP 协议网关与注册中心: 内置工具 + 上游 server 聚合(http/stdio) + 一致性门禁</description>
    <url>https://github.com/z-opc-foundation/z-mcp</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-mcp.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-mcp.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-mcp</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-mcp-api</module>
        <module>z-mcp-core</module>
        <module>z-mcp-starter</module>
        <module>z-mcp-admin</module>
        <!-- 可执行进程: 只在 publish-central.yml 的 -pl 白名单**之外**, 所以不会被发到中央仓库. -->
        <module>z-mcp-server</module>
    </modules>

    <properties>
        <!-- 版本口径全部由 parent 链下发，这里只留版本的单一真源。删掉的三格与父链面值逐字相同
             （z-boot-parent/pom.xml:56-58、66）：maven.compiler.source/target=8、
             project.build.sourceEncoding=UTF-8、spring-boot.version=2.7.18。前两格在 6 个 pom 里
             没有别的引用点；spring-boot.version 只剩 z-mcp-server 那一处插件引用，键删、引用留着
             由父链解析（central_pom_scan 的 E 类不给"插件无版本"过关）。 -->
        <revision>0.2.1</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== 自家 reactor 坐标逐条钉 ${project.version} =====
                 继承来的 fleet 把 z-mcp-api/core/starter/admin 钉在 repo1 的旧对外面值，而本仓
                 <revision> 已经往前走 ⇒ 不写这几条，仓内构建会被旧的对外面值反向污染（z-cache 试点
                 那格）。z-mcp-server 也在中央上（本仓没有 excludeArtifacts，实测 repo1 的
                 z-mcp-server/maven-metadata.xml 里 latest=0.2.0 且 0.2.0.pom ranged GET 206；
                 更早的 0.1.2 那版确实没发，404）—— 它是 reactor 成员，所以这一格同样必须钉住。
                 ⚠ 这句话在 8e12fdc 之前写的是"不在中央上（excludeArtifacts）"，那是错的口径，
                 2026-09-29 点 bundle 时才现形：演练包里 z-mcp-server 的 pom+jar+sources+javadoc
                 四件套齐。要不要把它改成像 z-indexer 那样用 excludeArtifacts 挡在门外，是
                 "已经公开出去的坐标怎么收"的问题，另议，不在这一刀里顺手改。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- spring-boot-dependencies 的 import 删掉：地板已经 import 同一格
                 spring-boot-dependencies:2.7.18（z-boot-dependencies/pom.xml:42、224-228），
                 与本仓面值相同 ⇒ 重复 import 只是 dm 打架的来源。 -->
        </dependencies>
    </dependencyManagement>
    <dependencies>
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承，
         子模块一律不再各自声明 junit；版本由根 DM / 地板 junit-bom 统一下发）：
           * junit-jupiter        — JUnit 5 新测试（API + 引擎）
           * junit-vintage-engine — 老 JUnit 4 测试（org.junit.Test）跑在 JUnit 5 平台上 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- maven-compiler-plugin 的声明删掉：口径交给 parent 的 pluginManagement 下发
                 （source/target 8 + UTF-8 + -parameters，插件版本 3.15.0 → 3.11.0，产出的 class
                 仍是 major 52，已复验）。本仓没有 surefire 声明。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <!--
                          ZMcpAutoConfiguration 读的是 ZMcpAutoConfiguration.class 那个包(= z-mcp-starter jar)
                          的 Implementation-Version, 并声称"配置值只作兜底". 默认情况下 maven-jar-plugin
                          根本不发这个头 ⇒ 那条判据恒为 null, 线上报的版本永远是 yml 里手抄的那一个(会漂).
                          写在根 pom 是为了每个模块的 jar 各自报出自己的真实版本.
                          层级必须是 archive/manifest: 少一层 manifest 的话 jar 插件报
                          "Cannot find 'addDefaultImplementationEntries' in MavenArchiveConfiguration"
                          并直接中止构建 —— 只有跑到 package/jar 才看得见, 单测编译期不报.
                        -->
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <!--
                flatten-maven-plugin: 多模块项目发布到 Sonatype Central Portal 时,
                根 POM 的元素(name/license/scm)不会被子模块继承, 必须用 flatten 把所有元信息注入到 .flattened-pom.xml
                模式与版本（parent 那条 flatten 是 inherited=false，不下发；插件版本留 1.7.2）。
                flattenMode=oss（2026-09-29 从 resolveCiFriendliesOnly 改）：旧模式下五份叶子发布 pom
                都留着 <parent>z-mcp</parent> 且依赖不带版本，外部工程要顺着 z-mcp → z-boot-parent →
                z-boot-fleet 才能补齐版本 ⇒ 我们的 parent 链成了消费者的一部分。oss 把 parent 剥掉、
                版本落成字面量，和 z-mq/z-cache/z-gw/z-llm 同形状（实测 z-agent 切 oss 后 name/url/
                licenses/scm 由 flatten 从父链注入，不用逐模块补元信息）。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.2</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Central 发布 profile -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <failOnError>false</failOnError>
                                    <failOnWarnings>false</failOnWarnings>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 缺这一行时 deploy 只会把 deployment 推到 validated 态(插件默认 autoPublish=false),
                                 构件对外不可见, 而 Maven 一路报 BUILD SUCCESS。实测 deployment 6baf402c（0.2.0）就是
                                 这样停在 VALIDATED、错误 0 却永远不公开。与其余 25 仓一致。 -->
                            <autoPublish>true</autoPublish>
                            <!-- 本插件不认 maven.deploy.skip，没排除的模块照样进 bundle
                                 （实测结论见 z-schedule/pom.xml 同位置注释）⇒ 不可发布的模块点名列出。
                              · z-mcp-admin：管理端可执行应用，只有主类 + 数据源配置，repackage 不带
                                  classifier ⇒ 产物是执行 fat jar，不是别仓可引的库件。 -->
                            <excludeArtifacts>
                                <excludeArtifact>z-mcp-admin</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>