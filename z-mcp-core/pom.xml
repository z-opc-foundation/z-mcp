<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-mcp</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mcp-core</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-mcp-core</name>
    <description>MCP 注册中心 + McpServer (JSON-RPC over HTTP/SSE) + McpClient 默认实现</description>

    <dependencies>
        <!-- 版本由仓根 DM 的 ${project.version} 下发（原先这里的 ${revision} 压过一切 DM）-->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- Streamable HTTP 需要直接读 Origin/Host/session 头, 故依赖 Servlet API(容器提供) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!-- JSON-RPC 的读写由这族承接(JsonUtil/JsonCursor/JsonObject/JsonArray), 版本由仓根 DM 下发。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>
        <!-- 主源码已零 Jackson。这条只在测试期留着, 而且是**故意**留的:
             测试用例拿 Jackson 读回服务端写出的 JSON-RPC 信封, 于是 WireContractTest 钉的那批
             字面量是由一个与生产序列化器不同的解析器判定的 —— 若 z-util 把 {"a":1} 写成
             {"a": 1.0} 或加了引号, 测出来的是"对端真的收不到"而不是"我们自己的实现自洽"。
             迁测试时把它一起换成 Wire 只会让这个独立性消失, 所以不进主源码。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- MockHttpServletRequest: 传输层(状态码/头)可测, 不必起容器 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>