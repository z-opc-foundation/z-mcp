<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-mcp</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mcp-starter</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-mcp-starter</name>
    <description>Spring Boot 自动装配: ZMcpAutoConfiguration + spring.factories</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-core</artifactId>
        </dependency>

        <!--
          控制面必须真的在 classpath 上, @ComponentScan("com.zifang.z.mcp.admin") 才扫得到东西.
          0.1.x 到 0.2.0 之间没有任何 pom 依赖过 z-mcp-admin, 于是 z.mcp.expose-admin=true
          扫的是一个不存在的包 ⇒ 静默什么都不挂载, 开关等于没有.
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-admin</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 装配要扫到 JsonRpcController, 它的签名里有 servlet 类型; 运行时由容器提供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>


        <!--
          ZMcpHttpEndpointTest 要起真 Tomcat: base-path / expose-admin 是"Spring 自己绑定"的两个字段,
          ApplicationContextRunner 只能验到 bean 在不在, 验不到 URL 到底挂在哪个路径上 ——
          而下游接的恰恰是路径. 只在 test scope, 不把 servlet 容器强加给引 starter 的业务系统.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 地板那条 spring-boot-starter-logging 带 `<exclusions>*:*</exclusions>`
             （z-boot-dependencies/pom.xml:500-510）⇒ 迁移后 logback 不再随 test 域的 starter-web 进来。
             src/main 现读 0 处 logback，但 3 个测试类（ServerSideLogCapture 那一族，15 处引用）把尺架在
             logback 的 LoggerContext 上 ⇒ 按 test 域复原，版本由父链下发（1.2.12，与基线同值）。
             jul-to-slf4j / log4j-to-slf4j 不复原：全仓 0 处 java.util.logging、0 处 log4j。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>