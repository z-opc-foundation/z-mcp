<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-mcp</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mcp-starter</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-mcp-starter</name>
    <description>Spring Boot 自动装配: ZMcpAutoConfiguration + spring.factories</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-core</artifactId>
            <version>${revision}</version>
        </dependency>

        <!--
          控制面必须真的在 classpath 上, @ComponentScan("com.zifang.z.mcp.admin") 才扫得到东西.
          0.1.x 到 0.2.0 之间没有任何 pom 依赖过 z-mcp-admin, 于是 z.mcp.expose-admin=true
          扫的是一个不存在的包 ⇒ 静默什么都不挂载, 开关等于没有.
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-admin</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 装配要扫到 JsonRpcController, 它的签名里有 servlet 类型; 运行时由容器提供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          ZMcpHttpEndpointTest 要起真 Tomcat: base-path / expose-admin 是"Spring 自己绑定"的两个字段,
          ApplicationContextRunner 只能验到 bean 在不在, 验不到 URL 到底挂在哪个路径上 ——
          而下游接的恰恰是路径. 只在 test scope, 不把 servlet 容器强加给引 starter 的业务系统.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>