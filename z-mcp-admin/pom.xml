<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-mcp</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mcp-admin</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-mcp-admin</name>
    <!-- 挂载前缀 z.mcp.base-path 是 Spring 的配置键（AdminController 的 @RequestMapping 把它与
         /mcp/admin 拼起来，默认空串），不是 Maven 属性：原先 <description> 里写成美元大括号形式 ⇒
         Maven 对模型做插值，而该键在仓内与父链都没有定义，发布出去的 pom 上就挂着一串悬空引用。
         改成字面写法，键不进 <properties>，运行时行为一字未动。 -->
    <description>控制面 REST (servers/tools/health 视图)，挂载在 z.mcp.base-path 前缀下的 /mcp/admin/*</description>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-mcp-core</artifactId>
        </dependency>

        <!--
          AdminController 要读 Origin/Host/Authorization 三个头, 与数据面共用同一把安全闸.
          与 z-mcp-core 一样按 provided 依赖: 运行时由容器提供.
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>